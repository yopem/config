{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "test": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": false,
      "dependsOn": ["^lint", "^build", "@yopem/oxlint-config#build"]
    },
    "lint:fix": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^typecheck", "^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
