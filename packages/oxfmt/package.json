{
  "name": "@yopem/oxfmt-config",
  "version": "0.0.11",
  "description": "",
  "keywords": [
    "config",
    "oxfmt",
    "oxfmt-config"
  ],
  "bugs": {
    "url": "https://github.com/yopem/config/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/config.git",
    "directory": "packages/oxfmt"
  },
  "files": [
    "src/.oxfmtrc.json",
    "dist",
    "bunfig.toml"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/.oxfmtrc.json",
  "module": "src/.oxfmtrc.json",
  "types": "src/.oxfmtrc.json",
  "exports": {
    ".": "./src/.oxfmtrc.json",
    "./oxfmtrc.json": "./src/.oxfmtrc.json",
    "./config": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bunfig.toml": "./bunfig.toml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --outdir=dist --packages=external && tsc --declaration --emitDeclarationOnly --outDir dist --module nodenext --target es2022 --moduleResolution nodenext --skipLibCheck src/index.ts",
    "sync:bun": "bun ./src/sync-bunfig.ts && oxfmt --write src/.oxfmtrc.json bunfig.toml",
    "prepack": "bun run build && bun run sync:bun",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.config.ts ."
  },
  "dependencies": {
    "oxfmt": "^0.71.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "oxlint": "1.76.0"
  },
  "peerDependencies": {
    "oxfmt": "^0.36.0 || ^0.60.0 || ^0.62.0 || ^0.63.0 || ^0.67.0 || ^0.71.0"
  }
}
