{
  "name": "@yopem/oxlint-config",
  "version": "0.3.1",
  "description": "",
  "keywords": [
    "config",
    "oxlint",
    "oxlint-config"
  ],
  "bugs": {
    "url": "https://github.com/yopem/config/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/config.git",
    "directory": "packages/oxlint"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/presets/effect.d.ts",
      "default": "./dist/presets/effect.js"
    },
    "./react-native": {
      "types": "./dist/presets/react-native.d.ts",
      "default": "./dist/presets/react-native.js"
    },
    "./tanstack-start": {
      "types": "./dist/presets/tanstack-start.d.ts",
      "default": "./dist/presets/tanstack-start.js"
    },
    "./react": {
      "types": "./dist/presets/react.d.ts",
      "default": "./dist/presets/react.js"
    },
    "./nextjs": {
      "types": "./dist/presets/nextjs.d.ts",
      "default": "./dist/presets/nextjs.js"
    },
    "./plugins/*": "./dist/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/*.ts ./src/*/index.ts ./src/presets/*.ts --target=node --root=./src --outdir=dist --packages=external && tsc --declaration --emitDeclarationOnly --outDir dist --module nodenext --target es2022 --moduleResolution nodenext --skipLibCheck src/index.ts src/presets/*.ts",
    "test": "bun run build && bun test ./test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "1.76.0",
    "eslint-plugin-oxfmt": "^0.22.0",
    "oxlint": "1.76.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "^7.0.0"
  },
  "peerDependencies": {
    "eslint-plugin-oxfmt": "^0.1.0 || ^0.15.0 || ^0.17.0 || ^0.18.0 || ^0.22.0",
    "oxlint": "^1.76.0"
  }
}
